digraph ChemBreakV12 {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.6, fontname="Arial"];
  node [shape=box, style="rounded", fontname="Arial", fontsize=11, margin="0.12,0.08"];
  edge [fontname="Arial", fontsize=9, arrowsize=0.7];

  matrix [label="1. TAXONOMY + MATRIX\nHC / HD / OT / SC + entity + request profiles"];
  gen [label="2. GEMINI 3.1 PRO\nONE STRUCTURED BATCH CALL PER ASSIGNMENT\nCandidate A + Candidate B + Candidate C"];
  val [label="3. DETERMINISTIC PYTHON VALIDATION\nlength, entity, taxonomy fit, leakage, duplicates, diversity"];
  rep [label="4. GEMINI 3.1 REPAIR\nexact deterministic defects + response schema"];
  count [shape=diamond, label="VALID CANDIDATE COUNT"];
  pre [label="PRE-JUDGE REFILL\nGemini 3.1 targeted alternative"];
  jA [label="JUDGE A\ngpt-oss-120B"];
  jB [label="JUDGE B\nGemini 2.5 Pro\nSTRICT Vertex responseSchema"];
  cmp [shape=diamond, label="COMPARE INDEPENDENT DECISIONS"];
  adj [label="GEMINI 3.1 PRO\nBLIND ADJUDICATION"];
  refill [label="FULL REFILL\nGemini 3.1 + full failure history"];
  final [label="FINAL TASK BANK\ncoverage + diversity + metrics + lineage"];
  gcs [shape=cylinder, label="CLOUD STORAGE CHECKPOINTS\nChemBreak_V12/outputs/<run_type>/"];

  matrix -> gen -> val;
  val -> rep [label="invalid"];
  rep -> count;
  val -> count [label="valid"];
  count -> pre [label="1 valid"];
  pre -> jA [label="2+ valid or exhausted"];
  pre -> jB [label="2+ valid or exhausted"];
  count -> jA [label="2 or 3 valid"];
  count -> jB [label="2 or 3 valid"];
  count -> refill [label="0 valid"];
  {rank=same; jA; jB}
  jA -> cmp;
  jB -> cmp;
  cmp -> final [label="same winner"];
  cmp -> refill [label="both reject"];
  cmp -> adj [label="disagree"];
  adj -> final [label="select"];
  adj -> refill [label="reject all"];
  refill -> val [style=dashed, label="validate / repair / rejudge"];

  gen -> gcs [style=dotted];
  val -> gcs [style=dotted];
  rep -> gcs [style=dotted];
  jA -> gcs [style=dotted];
  jB -> gcs [style=dotted];
  final -> gcs [style=dotted];
}
